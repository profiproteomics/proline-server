        <dependency>
            <groupId>fr.proline</groupId>
            <artifactId>proline-dal</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
            <classifier>${scala.compat.version}-tests</classifier>
        </dependency>
        <dependency>
            <groupId>fr.proline</groupId>
            <artifactId>proline-databases</artifactId>
